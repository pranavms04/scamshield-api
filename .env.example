# Copy to .env and edit. Never commit .env.
DATABASE_URL=postgresql+asyncpg://scamshield:scamshield@localhost:5432/scamshield
JWT_SECRET=change-me-to-a-long-random-string
AUTO_CREATE_TABLES=false
EMBEDDER=hashing            # or: sentence-transformers
LLM_PROVIDER=ollama         # or: rules (no LLM, offline fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
RATE_LIMIT_PER_MINUTE=60
